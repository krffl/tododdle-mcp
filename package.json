{
  "name": "tododdle-mcp",
  "version": "2.6.0",
  "description": "Agent-first task, project context, and time tracking for ToDoddle",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tododdle-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".codex-plugin",
    "skills",
    "examples"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/index.js",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tododdle",
    "project-management"
  ],
  "author": "ToDoddle",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krffl/tododdle-mcp.git"
  },
  "homepage": "https://tododdle.com",
  "bugs": {
    "url": "https://github.com/krffl/tododdle-mcp/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "prettier": "^3.3.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
